# tproxy-rs + MTProto-proxy — 1-командный деплой
# Скопируй в .env (или запусти ./deploy.sh — он создаст .env с случайным секретом).

# Публичный hostname, на котором будет прокси (должен указывать на этот сервер: A/AAAA запись)
TPROXY_HOSTNAME=tproxy.example.com

# Маскировочная страница: папка с вашим сайтом (отдаётся на всех путях, кроме ?bridge=)
TPROXY_SITE_DIR=./site

# (необязательно) переопределить secret вручную — 32 hex символа (16 байт).
# Если не задано — deploy.sh сгенерирует случайный.
#TPROXY_SECRET=

# (необязательно) транспорт: websocket | https | https-lanes | websocket-lanes
#TPROXY_CARRIER=websocket

# (необязательно) адрес MTProto-proxy (в compose — mtproxy:2398)
#TPROXY_MPROXY=mtproxy:2398
